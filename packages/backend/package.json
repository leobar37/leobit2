{
  "name": "@avileo/backend",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "bun run --watch --no-clear-screen src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run src/seed/index.ts",
    "db:seed:client": "bun run src/seed/index.ts --client",
    "db:seed:demo": "bun run src/seed/demo-user.ts",
    "db:backfill-sync": "bun run src/seed/backfill-sync-operations.ts",
    "db:reset": "bun run scripts/reset-db.ts",
    "db:apply-migration": "bun run scripts/run-migration.ts",
    "db:backup": "bun run scripts/backup-db.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "vitest run --config=vitest.e2e.config.ts",
    "test:e2e:watch": "vitest --config=vitest.e2e.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@ai-sdk/moonshotai": "^2.0.10",
    "@avileo/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.988.0",
    "@aws-sdk/s3-request-presigner": "^3.988.0",
    "@elysiajs/cors": "^1.4.0",
    "@gymspace/evolution": "^1.7.39",
    "ai": "^6.0.116",
    "better-auth": "^1.4.18",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.18",
    "inngest": "^3.52.6",
    "pino": "^10.3.1",
    "postgres": "^3.4.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.8",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
