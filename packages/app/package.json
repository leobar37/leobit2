{
  "name": "@avileo/app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "bun run server.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest",
    "test:integration": "vitest --config=vitest.integration.config.ts",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:headed": "HEADED=1 playwright test --config=playwright.config.ts",
    "test:e2e:ui": "playwright test --ui --config=playwright.config.ts",
    "test:e2e:debug": "playwright test --debug --config=playwright.config.ts",
    "test:e2e:report": "playwright show-report",
    "test:e2e:with-server": "WEB_SERVER=1 playwright test --config=playwright.config.ts",
    "test:e2e:msw": "playwright test --config=playwright.msw.config.ts",
    "test:e2e:msw:headed": "HEADED=1 playwright test --config=playwright.msw.config.ts",
    "test:e2e:volume": "playwright test --config=playwright.volume.config.ts",
    "test:e2e:perf": "playwright test --config=playwright.perf.config.ts",
    "test:e2e:smoke": "playwright test --config=playwright.smoke.config.ts",
    "db:migrate": "bun scripts/migrate-to-pglite.ts",
    "db:rollback": "bun scripts/rollback-migration.ts",
    "db:rollback:verify": "bun scripts/rollback-migration.ts --verify-only",
    "db:rollback:clear": "bun scripts/rollback-migration.ts --clear-only",
    "db:rollback:test": "bun scripts/rollback-migration.ts --file-based"
  },
  "dependencies": {
    "@avileo/shared": "workspace:*",
    "@date-fns/tz": "^1.4.1",
    "@electric-sql/pglite": "^0.3.15",
    "@elysiajs/eden": "^1.4.8",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-router/fs-routes": "^7.9.2",
    "@react-router/node": "^7.9.2",
    "@react-router/serve": "^7.9.2",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-persist-client": "5.90.21",
    "better-auth": "^1.4.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.18",
    "drizzle-orm": "^0.45.1",
    "framer-motion": "^12.36.0",
    "isbot": "^5",
    "jotai": "^2.18.1",
    "lucide-react": "^0.563.0",
    "nuqs": "^2.8.9",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.1",
    "react-markdown": "^10.1.0",
    "react-router": "^7.9.2",
    "recharts": "^3.8.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@avileo/backend": "workspace:*",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.58.2",
    "@react-router/dev": "^7.9.2",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.24",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^16.5.2",
    "jsdom": "^28.1.0",
    "msw": "^2.12.10",
    "postcss": "^8.5.6",
    "react-grab": "0.1.28",
    "sharp": "^0.34.5",
    "tailwindcss": "3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.2",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.0.2",
    "workbox-window": "^7.4.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
