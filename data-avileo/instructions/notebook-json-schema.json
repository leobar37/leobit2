{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avileo.local/schemas/notebook-json-schema.json",
  "title": "Notebook Image Extraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "imageId",
    "imageFile",
    "sourceDataset",
    "pass",
    "schemaVersion",
    "blocks"
  ],
  "properties": {
    "imageId": {
      "type": "string"
    },
    "imageFile": {
      "type": "string"
    },
    "sourceDataset": {
      "type": "string"
    },
    "pass": {
      "type": "string",
      "enum": [
        "pass-1",
        "pass-2"
      ]
    },
    "extractedAt": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string"
    },
    "imageLevelNotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ignoredDetachedText": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rawText",
          "reason"
        ],
        "properties": {
          "rawText": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "detectedDates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rawText",
          "normalizedDate",
          "confidence"
        ],
        "properties": {
          "rawText": {
            "type": "string"
          },
          "normalizedDate": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number"
          }
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "blockIndex",
          "date",
          "lines"
        ],
        "properties": {
          "blockIndex": {
            "type": "integer"
          },
          "date": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rawText",
              "normalizedDate",
              "inheritedFromPreviousBlock",
              "confidence"
            ],
            "properties": {
              "rawText": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "normalizedDate": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "inheritedFromPreviousBlock": {
                "type": "boolean"
              },
              "confidence": {
                "type": "number"
              }
            }
          },
          "blockNotes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lineIndex",
                "rawLineText",
                "lineType",
                "entries",
                "customer",
                "items",
                "operations",
                "amounts",
                "payment",
                "markers",
                "reviewFlags",
                "confidence"
              ],
              "properties": {
                "lineIndex": {
                  "type": "integer"
                },
                "rawLineText": {
                  "type": "string"
                },
                "lineType": {
                  "type": "string",
                  "enum": [
                    "single_entry_line",
                    "multi_entry_line",
                    "carry_over_line",
                    "date_header_line",
                    "note_only_line",
                    "unknown_line"
                  ]
                },
                "customer": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "rawName",
                    "normalizedCandidate",
                    "similarTo",
                    "confidence"
                  ],
                  "properties": {
                    "rawName": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "normalizedCandidate": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "similarTo": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "confidence": {
                      "type": "number"
                    }
                  }
                },
                "entries": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "entryIndex",
                      "entryType",
                      "description",
                      "customerRef",
                      "amount",
                      "paymentMethod",
                      "paymentStatus",
                      "confidence"
                    ],
                    "properties": {
                      "entryIndex": {
                        "type": "integer"
                      },
                      "entryType": {
                        "type": "string",
                        "enum": [
                          "sale",
                          "payment_confirmed",
                          "pending_yape_payment",
                          "no_payment_marker",
                          "balance_reference",
                          "previous_payment_reference",
                          "product_fragment",
                          "unknown_entry"
                        ]
                      },
                      "description": {
                        "type": "string"
                      },
                      "customerRef": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "amount": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "paymentMethod": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "enum": [
                          "efectivo",
                          "yape",
                          "plin",
                          "transferencia",
                          "tarjeta",
                          "saldo",
                          null
                        ]
                      },
                      "paymentStatus": {
                        "type": "string",
                        "enum": [
                          "paid",
                          "pending_yape",
                          "no_pago",
                          "partial",
                          "unknown"
                        ]
                      },
                      "confidence": {
                        "type": "number"
                      }
                    }
                  }
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "rawText",
                      "normalizedProductCandidate",
                      "similarTo",
                      "quantityText",
                      "unitPrice",
                      "lineAmount",
                      "confidence"
                    ],
                    "properties": {
                      "rawText": {
                        "type": "string"
                      },
                      "normalizedProductCandidate": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "similarTo": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "quantityText": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "unitPrice": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "lineAmount": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "confidence": {
                        "type": "number"
                      }
                    }
                  }
                },
                "operations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "rawText",
                      "operator",
                      "operands",
                      "result",
                      "confidence"
                    ],
                    "properties": {
                      "rawText": {
                        "type": "string"
                      },
                      "operator": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "operands": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      },
                      "result": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "confidence": {
                        "type": "number"
                      }
                    }
                  }
                },
                "amounts": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "subtotal",
                    "total",
                    "amountPaid",
                    "balanceDue",
                    "highlightedAmount"
                  ],
                  "properties": {
                    "subtotal": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "total": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "amountPaid": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "balanceDue": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "highlightedAmount": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  }
                },
                "payment": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "paymentMethod",
                    "paymentStatus",
                    "yapeoConfirmed",
                    "pendingYape",
                    "noPago",
                    "referencesPreviousPayment",
                    "carryOverFromPrevious"
                  ],
                  "properties": {
                    "paymentMethod": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "enum": [
                        "efectivo",
                        "yape",
                        "plin",
                        "transferencia",
                        "tarjeta",
                        "saldo",
                        null
                      ]
                    },
                    "paymentStatus": {
                      "type": "string",
                      "enum": [
                        "paid",
                        "pending_yape",
                        "no_pago",
                        "partial",
                        "unknown"
                      ]
                    },
                    "yapeoConfirmed": {
                      "type": "boolean"
                    },
                    "pendingYape": {
                      "type": "boolean"
                    },
                    "noPago": {
                      "type": "boolean"
                    },
                    "referencesPreviousPayment": {
                      "type": "boolean"
                    },
                    "carryOverFromPrevious": {
                      "type": "boolean"
                    }
                  }
                },
                "markers": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "hasCircledAmount",
                    "hasArrow",
                    "hasP",
                    "hasNP",
                    "hasYapeo",
                    "hasXYapear"
                  ],
                  "properties": {
                    "hasCircledAmount": {
                      "type": "boolean"
                    },
                    "hasArrow": {
                      "type": "boolean"
                    },
                    "hasP": {
                      "type": "boolean"
                    },
                    "hasNP": {
                      "type": "boolean"
                    },
                    "hasYapeo": {
                      "type": "boolean"
                    },
                    "hasXYapear": {
                      "type": "boolean"
                    }
                  }
                },
                "reviewFlags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "confidence": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  }
}
